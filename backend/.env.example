# TiDB Cloud Serverless (produção)
DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
DB_USER=seu_usuario.root
DB_PASSWORD=sua_senha
DB_NAME=smg_merch
DB_PORT=4000
DB_SSL=true

# Server
PORT=3000
NODE_ENV=development

# Session - gere uma chave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_aqui

# CORS - domínio do frontend em produção
CORS_ORIGIN=http://localhost:3000

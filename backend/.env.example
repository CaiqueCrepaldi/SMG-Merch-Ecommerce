# MySQL Database (local)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=smg_merch
# DB_PORT=3306
# DB_SSL=false

# TiDB Cloud Serverless (produção)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_USER=SEU_USUARIO.root
DB_PASSWORD=SUA_SENHA_TIDB
DB_NAME=smg_merch
DB_PORT=4000
DB_SSL=true

# Server
PORT=3000
NODE_ENV=development

# Session - gere uma chave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_aqui

# CORS - domínio do frontend em produção
CORS_ORIGIN=http://localhost:3000

# Email (Gmail SMTP para recuperação de senha)
SMTP_EMAIL=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_google

# URL pública do app (para links nos emails)
APP_URL=https://seu-app.onrender.com
